# Raw sequence files (large FASTA/GenBank downloads — fetch with 01_download.sh)
data/raw/*.fasta
data/raw/*.fa
data/raw/*.gb
data/raw/*.gbk

# Per-serotype subsets and alignments (generated by 02_align.sh)
data/aligned/

# IQ-TREE2 intermediate files
results/trees/*.log
results/trees/*.iqtree
results/trees/*.bionj
results/trees/*.mldist
results/trees/*.model.gz
results/trees/*.ckp.gz
results/trees/*.splits.nex

# R environment and renv lockfile cache
.Rproj.user/
renv/library/
renv/staging/
*.Rproj

# R rendered output (regenerate with rmarkdown::render)
report/*.html
report/*.pdf

# macOS metadata
.DS_Store

# Editor backup files
*~
*.swp

# Python cache files
__pycache__/
*.py[cod]
